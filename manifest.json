{
  "manifest_version": 3,
  "name": "Handsfree Voice & Vision Interaction System",
  "version": "1.0.0",
  "description": "Hands-free browser interaction combining local Whisper speech recognition and webcam nose tracking.",
  "permissions": [
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "handsfree-addon@local.dev",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "page": "background.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}